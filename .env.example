# Backend URL seen from the front container (shared network with wtw-api)
API_URL=http://wtw-api:3000
PORT=4000
# BFF timeout for API calls: 504 when exceeded, 502 when the API is unreachable
API_TIMEOUT_MS=10000
# true behind HTTPS (adds Secure to the cookies)
COOKIE_SECURE=false
# Public domains Angular SSR accepts in the Host header (comma separated)
# NG_ALLOWED_HOSTS=wtw.example.com
# Origin the SSR uses to call its own /api (defaults to http://localhost:$PORT)
# INTERNAL_ORIGIN=http://localhost:4000
# Max wait for each /api call during SSR; then the browser loads the data
# SSR_API_TIMEOUT_MS=3000
